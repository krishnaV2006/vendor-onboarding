# Copy this file to .env and fill in your own key. Never put a real key in this file.
# Which AI reads documents: gemini, claude or off. Without a key the backup text parser runs and scans go to a person.
VENDOR_AI_PROVIDER=gemini
GEMINI_API_KEY=your-key
# ANTHROPIC_API_KEY=your-key
# Optional settings
# VENDOR_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
# VENDOR_CLAUDE_MODEL=claude-opus-5-5
# VENDOR_MAX_RUNS_PER_DAY=300
# VENDOR_MIN_STAGE_MS=450
